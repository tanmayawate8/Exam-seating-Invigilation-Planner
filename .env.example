# ==============================================================================
# Environment Configuration Template (DO NOT COMMIT REAL CREDENTIALS)
# Online Exam Seating & Invigilation Planner
# ==============================================================================

# Flask Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Security (Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-secure-random-secret-key

# PostgreSQL Database Connection
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/exam_planner_db

# Test Database Connection (Used for automated test suites)
TEST_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/exam_planner_test_db
